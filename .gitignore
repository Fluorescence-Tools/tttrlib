# Build outputs
# Root-anchored: rattler-build's path source copy honors .gitignore, and an
# unanchored build/ would drop the tracked thirdparty/libtiff/build/ directory.
/build/
bld-dir/
dist/
dist
*.whl
wheelhouse/
wheelhouse_*/
build_log.txt
debug_*.py
doc/auto_examples
tmp/
.venv
.boost_env
playground
junk/
venv
# root-level build/install copy only — must not match nested package dirs
# such as ext/**/io/github/fluorescencetools/tttrlib/ or ext/python/tttrlib.*
/tttrlib
!bin/tttrlib

# Local planning and agent state
PRDs/
PLANS/
.omx/

# Windows artifacts
nul

# CMake builds
cmake-build-*/
cmake-build-release/
build-*/
CMakeCache.txt
CMakeFiles/
CMakeScripts/
Testing/
cmake_install.cmake
compile_commands.json
CTestTestfile.cmake
DartConfiguration.tcl
install_manifest.txt
_deps/

# Local ImageJ/Fiji plugin build & launch folder (native libs, ij.jar, jars)
imagej-test/

# Conda/rattler build output
conda-bld/
docsenv/

# act cache
.act-cache/

# Local tooling state
.claude/settings.local.json

# Documentation and tools
doc/_*
doc/xml
doc/_build/
doc/paper*
/doc/examples/
doc/sg_execution_times.rst

# IDE
.vscode
.vs
.idea/
.cache

# Python
__pycache__
*.egg-info/
.eggs/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.tox/
.nox/
.benchmarks/
.ipynb_checkpoints
.coverage
.coverage.*
coverage.xml
htmlcov/
pip-wheel-metadata/

# Test data
tttr-data
test/tttr-data

# Scratch and temporary
leftovers/
temp/
optimization-docs/

# Test diagnostics (generated by test runs)
test/diagnostics/*.png
