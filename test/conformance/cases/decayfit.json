      "id": "decayfit.the_registry_describes_every_model",
      "doc": "The fitters, their setup parameters and their result names are pure data, so they must be identical in four languages -- and a setup vector built from an empty JSON object has one entry per setup name, which is the invariant that keeps the two lists in step.",
      "steps": [
        {"op": "fit.names", "as": "models"},
        {"op": "fit.setup_names", "args": ["fit23"], "as": "setup_names"},
        {"op": "fit.setup_vector", "args": ["fit23", "{}"], "as": "setup_defaults"},
        {"op": "len", "on": "setup_names", "as": "n_setup_names"},
        {"op": "len", "on": "setup_defaults", "as": "n_setup_values"},
        {"op": "fit.result_names", "args": ["fit23"], "as": "result_names"},
        {"op": "first", "on": "result_names", "as": "first_result"}
      ],
      "expect": {
        "models": ["fit23", "fit24", "fit25", "fit26", "fit_nexp"],
        "setup_names": [
          "dt",
          "period",
          "g_factor",
          "l1",
          "l2",
          "convolution_stop",
          "soft_bifl_scatter_flag",
          "objective",
          "fit_start",
          "fit_stop"
