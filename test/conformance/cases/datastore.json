{
  "area": "datastore",
  "doc": "The DataStore group tree and its HDF5 round trip -- the acceptance criteria, run from every binding that wraps DataStore. The criterion is these cases passing in four languages.",
  "cases": [
    {
      "id": "datastore.group_handle_survives_50_adds",
      "doc": "The handle taken before the fifty adds still names the same group, with its label, row count and data intact. This is the columns-vector reallocation bug, not repeated -- a container that moves its children would fail here and nowhere else.",
      "steps": [
        {"op": "ds.new", "as": "root"},
        {"op": "ds.add_group", "on": "root", "args": ["keep"], "as": "keep"},
        {"op": "ds.add_f64", "on": "keep", "args": ["v", [1.0, 2.0, 4.0, 8.0]]},
        {"op": "ds.set_label", "on": "keep", "args": ["the handle"]},
        {"op": "ds.add_group", "on": "root", "args": ["g00"]},
        {"op": "ds.add_group", "on": "root", "args": ["g01"]},
        {"op": "ds.add_group", "on": "root", "args": ["g02"]},
        {"op": "ds.add_group", "on": "root", "args": ["g03"]},
        {"op": "ds.add_group", "on": "root", "args": ["g04"]},
