# ImageJ menu configuration for the tttrlib plugin JAR.
# Format:  <menu path>, "<label>", <fully.qualified.ClassName>
Plugins>tttrlib, "Open TTTR CLSM Image", io.github.fluorescencetools.tttrlib.imagej.TTTR_CLSM_Reader
Plugins>tttrlib, "Decay from Mask", io.github.fluorescencetools.tttrlib.imagej.TTTR_Decay_From_Mask
